{
  "name": "pergunu-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pergunu-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pergunu-db --remote",
    "data:prepare": "node scripts/prepare-legacy-import.mjs",
    "data:import:local": "wrangler d1 execute pergunu-db --local --file=.generated/legacy-import.sql",
    "data:import:remote": "wrangler d1 execute pergunu-db --remote --file=.generated/legacy-import.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "sanitize-html": "^2.17.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.32.0"
  }
}
